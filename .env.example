# 复制为 .env 后修改：cp .env.example .env

# ---- 语音识别 ----
# funasr：本地识别（首次运行自动下载模型，约 1GB）
# mock  ：演示模式，返回固定示例对话，无需模型
XW_ASR_ENGINE=funasr

# ---- 大模型（任意 OpenAI 兼容接口）----
# DeepSeek   https://api.deepseek.com/v1                         deepseek-chat
# 通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1    qwen-plus
# Kimi       https://api.moonshot.cn/v1                          moonshot-v1-8k
# 智谱       https://open.bigmodel.cn/api/paas/v4                 glm-4-flash
# Ollama     http://host.docker.internal:11434/v1                qwen2.5:7b（API Key 随便填）
XW_LLM_BASE_URL=https://api.deepseek.com/v1
XW_LLM_API_KEY=
XW_LLM_MODEL=deepseek-chat
# 接口不支持 response_format=json_object 时设为 false
XW_LLM_JSON_MODE=true

# ---- 隐私 ----
# false：处理完成后删除原始音频，只保留文字
XW_KEEP_AUDIO=true
